# ==============================================================================
# Environment Configuration for MongoDB to S3 Backup Container
# ==============================================================================

# MongoDB Connection String (Required)
# Examples:
# Standard: mongodb://username:password@mongodb-host:27017/my_database?authSource=admin
# MongoDB Atlas (SRV): mongodb+srv://username:password@cluster0.abcde.mongodb.net/my_database
MONGO_URI=mongodb://root:example@localhost:27017/admin

# Target AWS S3 Bucket Name (Required)
S3_BUCKET=my-company-database-backups

# S3 Folder Prefix (Optional, default: mongodb-backups)
S3_PREFIX=mongodb-backups/production

# Explicit S3 Object Key (Optional, overrides auto-generated timestamp filename)
# S3_KEY=mongodb-backups/manual-latest.archive.gz

# AWS Credentials (Required if not using IAM Roles / IRSA / ECS Task Roles)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=AQoDYXdzEJr... (Optional, for temporary STS credentials)

# S3 Storage Class (Optional, default: STANDARD)
# Options: STANDARD, STANDARD_IA, ONEZONE_IA, INTELLIGENT_TIERING, GLACIER, DEEP_ARCHIVE
S3_STORAGE_CLASS=STANDARD

# Optional: Specific Database or Collection
# If unset, mongodump backs up all databases
# MONGO_DATABASE=my_app
# MONGO_COLLECTION=users

# Optional: Custom S3 Endpoint (for MinIO, LocalStack, Cloudflare R2, Wasabi, etc.)
# S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# S3_ENDPOINT_URL=http://minio:9000

# Optional: Extra flags for mongodump (e.g. '--oplog' for replica sets)
# MONGODUMP_EXTRA_ARGS=--oplog
